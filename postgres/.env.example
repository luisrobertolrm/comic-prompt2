# Copie para postgres/.env e preencha. Estes valores definem o banco e o usuário
# padrão do servidor Postgres. A sumi-api (e outras apps) usam estas credenciais.
POSTGRES_USER=sumi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sumi_db
# Porta exposta no host. Mude se 5432 já estiver em uso.
POSTGRES_PORT=5432
