# PostgreSQL — psycopg2 (binário, não precisa de libpq instalada)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sumi_db

# API Keys
GOOGLE_API_KEY=

# IA (texto, imagem, transcrição, voz e vídeo)
# Chaves, modelos e URLs são cadastrados na tela "Configurações do sistema" (admin),
# com uma configuração ativa por tipo. Este arquivo NÃO é lido para IA em tempo de execução.
# Exceção: a migração ai_config_tables lê uma única vez as variáveis antigas de IA
# (OPENAI_API_KEY, MINIMAX_*, BYTEPLUS_*, SEEDREAM_MODEL, STT_*, AI_*), se ainda existirem
# num .env antigo, para converter a configuração em registros do cadastro.

# Grava em sumi-api/seedream_payload.log o payload de cada geração de imagem. false desliga.
SEEDREAM_PAYLOAD_LOG=true
# Grava em sumi-api/minimax_payload.log o payload de cada geração de imagem. false desliga.
MINIMAX_PAYLOAD_LOG=true

# FastAPI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
# Prefixo do sub-path atrás de reverse-proxy (ex.: /sumi). Vazio = raiz.
# Em produção deve casar com o BASE_HREF do build do Angular.
ROOT_PATH=

# JWT
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
# Validade do token com "Lembrar de mim" (30 dias)
JWT_REMEMBER_EXPIRE_MINUTES=43200

# CORS
CORS_ORIGINS=http://localhost:4200

# Storage — "local" (default) or "railway"
STORAGE_BACKEND=local

# Railway Object Storage (required when STORAGE_BACKEND=railway)
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ENDPOINT_URL=
RAILWAY_BUCKET_ACCESS_KEY=
RAILWAY_BUCKET_SECRET_KEY=
RAILWAY_BUCKET_REGION=auto
RAILWAY_PUBLIC_URL=
