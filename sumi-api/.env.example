# PostgreSQL — psycopg2 (binário, não precisa de libpq instalada)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sumi_db

# API Keys
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Provider de IA ativo (singleton `ai`): openai | minimax | comfyui
# comfyui: imagem via Stable Diffusion local; texto continua no MiniMax
AI_PROVIDER=openai

# ComfyUI (AI_PROVIDER=comfyui) — Stable Diffusion local
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=
COMFYUI_STEPS=28
COMFYUI_CFG=6.0
COMFYUI_NEGATIVE=

# MiniMax — chave compartilhada; modelo separado por modalidade
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VOICE_MODEL=speech-2.8-hd
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3-Fast
# Grava em sumi-api/minimax_payload.log o payload de cada geração de imagem. false desliga.
MINIMAX_PAYLOAD_LOG=true

# FastAPI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# JWT
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
# Validade do token com "Lembrar de mim" (30 dias)
JWT_REMEMBER_EXPIRE_MINUTES=43200

# CORS
CORS_ORIGINS=http://localhost:4200

# Storage — "local" (default) or "railway"
STORAGE_BACKEND=local

# Railway Object Storage (required when STORAGE_BACKEND=railway)
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ENDPOINT_URL=
RAILWAY_BUCKET_ACCESS_KEY=
RAILWAY_BUCKET_SECRET_KEY=
RAILWAY_BUCKET_REGION=auto
RAILWAY_PUBLIC_URL=
