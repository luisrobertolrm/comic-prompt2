# PostgreSQL — psycopg2 (binário, não precisa de libpq instalada)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sumi_db

# API Keys
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Provider de IA ativo (singleton `ai`): openai | minimax
AI_PROVIDER=openai

# MiniMax — chave compartilhada; modelo separado por modalidade
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_VOICE_MODEL=speech-2.8-hd
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3-Fast

# FastAPI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# JWT
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:4200

# Storage — "local" (default) or "railway"
STORAGE_BACKEND=local

# Railway Object Storage (required when STORAGE_BACKEND=railway)
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ENDPOINT_URL=
RAILWAY_BUCKET_ACCESS_KEY=
RAILWAY_BUCKET_SECRET_KEY=
RAILWAY_BUCKET_REGION=auto
RAILWAY_PUBLIC_URL=
