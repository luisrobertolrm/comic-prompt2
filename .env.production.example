# Copie para `.env` na máquina Linux e preencha. NÃO comite o .env real.
#
#   cp .env.production.example .env
#   docker compose up -d --build

# ── Postgres (container interno do compose) ──────────────────────────────────
# A DATABASE_URL da API é montada automaticamente a partir destes valores no
# docker-compose.yml. Troque a senha por algo forte.
POSTGRES_USER=sumi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sumi_db
# Porta do Postgres exposta no host (para outras apps/clientes). Mude se 5432 já estiver em uso.
POSTGRES_PORT=5432

# ── Segurança ────────────────────────────────────────────────────────────────
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
JWT_REMEMBER_EXPIRE_MINUTES=43200

# ── Provider de IA ───────────────────────────────────────────────────────────
# openai | minimax | comfyui | seedream
AI_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
AI_TEXT_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-1

# Opcional: texto e imagem em providers diferentes (vazio = herda AI_PROVIDER)
AI_TEXT_PROVIDER=
AI_IMAGE_PROVIDER=

# Seedream (BytePlus) — só se usar imagem por aqui
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDREAM_MODEL=seedream-4-0-250828

# MiniMax — só se usar
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.io

# ── App / rede ───────────────────────────────────────────────────────────────
# Porta exposta no host Linux (a app sempre escuta 8000 dentro do container).
APP_PORT=8000

# Storage das imagens geradas: "local" grava no volume montado em /app/static/images
STORAGE_BACKEND=local

# CORS: a SPA é servida pelo próprio FastAPI, então normalmente pode ficar vazio.
# Preencha só se houver frontend externo chamando a API.
CORS_ORIGINS=
